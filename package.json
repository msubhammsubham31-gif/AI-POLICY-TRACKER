{
  "name": "regulamap",
  "version": "1.0.0",
  "description": "RegulaMap — Enterprise AI Regulatory & Environmental Compliance Drift Tracking Platform",
  "main": "server/dist/index.js",
  "scripts": {
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "server:dev": "ts-node server/src/index.ts",
    "client:dev": "npm --prefix client run dev",
    "build": "npm run build:server && npm run build:client",
    "build:server": "tsc -p server/tsconfig.json && node scripts/postbuild-server.js",
    "build:client": "npm --prefix client run build",
    "start": "node server/dist/index.js",
    "test": "vitest run",
    "test:server": "vitest run server/tests",
    "prisma:generate": "prisma generate",
    "migrate:supabase": "ts-node scripts/migrate-supabase.ts",
    "seed": "ts-node prisma/seed.ts"
  },
  "keywords": [
    "regulatory-compliance",
    "ai-agent",
    "drift-tracking",
    "esg",
    "gemini",
    "supabase",
    "maplibre"
  ],
  "author": "RegulaMap Engineering",
  "license": "MIT",
  "dependencies": {
    "@google/genai": "^0.2.0",
    "@prisma/client": "^6.4.1",
    "@supabase/supabase-js": "^2.49.1",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "diff": "^7.0.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.3",
    "uuid": "^11.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/diff": "^7.0.0",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.9",
    "@types/pg": "^8.11.11",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "concurrently": "^9.1.2",
    "prisma": "^6.4.1",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.2",
    "vercel": "^62.7.0",
    "vitest": "^3.0.8"
  }
}
